---
import AuthorPill from "@/components/AuthorPill.astro";
import BookCover from "@/components/BookCover.astro";
import ReadingSelect from "@/components/ReadingSelect.astro";
import { db } from "@/db/client";
import { Book } from "@/db/schema";
import BaseLayout from "@/layout/BaseLayout.astro";
import { eq } from "drizzle-orm";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

const [book] = await db.select().from(Book).where(eq(Book.id, id));

if (!book) {
  return Astro.redirect("/");
}

const { author, cover, status, title } = book;
---

<BaseLayout title={title}>
  <div class="grid-md">
    <div class="book-layout">
      <BookCover cover={cover} title={title} loading="eager" />
      <div class="grid-sm">
        <h1>{title}</h1>
        <AuthorPill author={author} />
        <ReadingSelect selectData={{ status, id }} />
      </div>
    </div>
    <button class="remove-book-button btn warning" data-id={id}
      >Remove from Library</button
    >
  </div>
</BaseLayout>

<script>
  import { parseResponse } from "@/lib/api";

  const removeButton = document.querySelector<HTMLButtonElement>(".remove-book-button");

  removeButton?.addEventListener("click", async () => {
    if (!confirm("Remove this book from your library?")) {
      return;
    }

    try {
      const res = await fetch(`/api/books/${removeButton.dataset.id}`, {
        method: "DELETE",
      });

      await parseResponse(res, "Failed to delete book. Please try again.");

      window.location.href = "/";
    } catch (error) {
      console.error(error);
      alert(error instanceof Error ? error.message : "Unknown error");
    }
  });
</script>
