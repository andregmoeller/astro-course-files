---
import BaseLayout from "@/layout/BaseLayout.astro";
---

<BaseLayout title="Register">
  <div class="grid-sm center-layout">
    <h1>Create Account</h1>
    <form id="register-form" class="grid-xs" action="/api/auth/register">
      <label>
        <span>Username</span>
        <input
          type="text"
          name="username"
          required
          autocomplete="username"
          minlength="3"
          maxlength="31"
          pattern="[a-z0-9_\-]+"
        />
      </label>
      <label>
        <span>Password</span>
        <input
          type="password"
          name="password"
          required
          autocomplete="new-password"
          minlength="8"
        />
      </label>
      <button type="submit" class="btn full-width">Register</button>
    </form>
    <p>Already have an account? <a href="/login">Log in</a></p>
  </div>
</BaseLayout>

<script>
  import { submitAsJson } from "@/lib/forms";

  const form = document.querySelector<HTMLFormElement>("#register-form");
  if (form) {
    submitAsJson(form, "Failed to create account. Please try again.", () => {
      window.location.href = "/";
    });
  }
</script>
