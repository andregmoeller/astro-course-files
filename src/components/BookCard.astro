---
import type { TBook } from "@/types/Books";
import ReadingSelect from "./ReadingSelect.astro";
import BookCover from "./BookCover.astro";
import AuthorPill from "./AuthorPill.astro";

type Props = {
  book: TBook;
};

const { book } = Astro.props;
---

<li class="book-card">
  <ReadingSelect selectData={{ status: book.status, id: book.id }} />
  <BookCover cover={book.cover} title={book.title} />
  <h3>{book.title}</h3>
  <AuthorPill author={book.author} />
  <a href={`/book/${book.id}`} class="btn">View Book</a>
</li>
