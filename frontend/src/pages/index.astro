---
import { getCollection, getEntries, getEntry, type CollectionEntry } from "astro:content";
import { TestimonialCard } from "../components/Testimonials";

// === START DEBUGGING ===
const allKeystatic = await getCollection("keystatic");
console.log("🔍 ASTRO HAT DIESE IDs GEFUNDEN:", allKeystatic.map(doc => doc.id));
// === END DEBUGGING ===

const testimonialSection = await getEntry("keystatic", "testimonialsection");

if (!testimonialSection) {
  throw new Error("CMS ERROR: Die Datei 'testimonialSection.yaml' wurde im Ordner 'src/content/keystatic/' nicht gefunden.");
}

const testimonials = await getEntries(testimonialSection.data.testimonials);

const testimonialData = {
  heading: testimonialSection.data.heading,
  testimonials: testimonials.map(({ data }: CollectionEntry<"testimonial">) => {
    return {
      ...data,
      image: data.image.src,
    };
   }),
};

export type TestimonialSectionType = typeof testimonialData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <TestimonialCard data={testimonialData} />
  </body>
</html>
